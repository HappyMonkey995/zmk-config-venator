if SHIELD_VENATOR_LEFT

# Name must be less than 16 characters long!
config ZMK_KEYBOARD_NAME
    default "Venator"

# Left half is the BLE central (talks to the host)
config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_VENATOR_LEFT || SHIELD_VENATOR_RIGHT

config ZMK_SPLIT
    default y

endif
