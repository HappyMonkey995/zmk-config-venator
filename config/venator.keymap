#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3  &kp N4   &kp N5      &kp N6  &kp N7    &kp N8     &kp N9   &kp N0    &kp BSPC
&kp TAB    &kp Q   &kp W   &kp E   &kp R    &kp T       &kp Y   &kp U     &kp I      &kp O    &kp P     &kp BSLH
&kp CAPS   &kp A   &kp S   &kp D   &kp F    &kp G       &kp H   &kp J     &kp K      &kp L    &kp FSLH  &kp RET
&kp LSHFT  &kp Z   &kp X   &kp C   &kp V    &kp B       &kp N   &kp M     &kp COMMA  &kp DOT  &kp UP    &kp DEL
&kp LCTRL  &kp LGUI &kp LALT &mo 1 &kp GRAVE &kp SPACE  &kp RALT &kp RCTRL &kp LBKT  &kp RBKT &kp DOWN  &kp RIGHT
            >;
        };

        fn_layer {
            display-name = "Fn";
            bindings = <
&trans  &kp F1     &kp F2     &kp F3     &kp F4     &kp F5      &kp F6    &kp F7    &kp F8     &kp F9     &kp F10   &trans
&trans  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4  &trans  &kp F11   &kp F12    &trans     &trans    &trans
&trans  &bt BT_CLR &trans     &trans     &trans     &trans      &kp MINUS &kp EQUAL &kp SEMI   &kp SQT    &trans    &trans
&trans  &bootloader &sys_reset &trans    &trans     &trans      &kp HOME  &kp END   &kp PG_UP  &kp PG_DN  &trans    &trans
&trans  &trans     &trans     &trans     &trans     &trans      &trans    &trans    &trans     &trans     &kp LEFT  &trans
            >;
        };
    };
};
